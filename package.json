{
  "name": "seekquel-bridge",
  "version": "0.1.2",
  "description": "Logs listening and reading from a self-hosted book server into Seekquel",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
