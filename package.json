    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
